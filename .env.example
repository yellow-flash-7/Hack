# Database Configuration (PostgreSQL 17)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/elov_db?schema=public"

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# AI Provider Configuration: "deterministic" (offline/zero-cost), "gemini", or "openai"
AI_PROVIDER="deterministic"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Document Upload & Storage Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25

# Verification Decision Thresholds (0.0 to 1.0)
SUPPORT_THRESHOLD=0.75
CONTRADICTION_THRESHOLD=0.70
NEEDS_REVIEW_MARGIN=0.15
MIN_RETRIEVAL_SIMILARITY=0.30
